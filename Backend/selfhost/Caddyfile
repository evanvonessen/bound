{
    email {$TLS_EMAIL}
    admin off
}

{$BOUND_HOSTNAME} {
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        -Server
    }
    # Only gameplay sockets and the authenticated durable-run RPC are public.
    # Native auth and administrative RPCs stay behind the account gateway.
    handle /ws {
        reverse_proxy nakama:7350
    }
    handle /v2/rpc/bound_run_v1 {
        reverse_proxy nakama:7350
    }
    handle /v2/rpc/bound_independent_v2 {
        reverse_proxy nakama:7350
    }
    handle {
        reverse_proxy gateway:8080 {
            header_up X-Bound-Client-IP {remote_host}
        }
    }
}
